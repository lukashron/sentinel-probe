{
    "name": "lukashron/sentinel-probe",
    "type": "project",
    "keywords": ["security", "php"],
    "authors": [
        {
            "name": "Lukas Hron",
            "email": "info@lukashron.cz"
        }
    ],
    "version": "1.0.0",
    "license": "PolyForm-Noncommercial-1.0.0",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "symfony/console": "^7.4",
        "symfony/http-client": "^7.4",
        "ext-dom": "*",
        "ext-libxml": "*"
    },
    "autoload": {
        "psr-4": {
            "LukasHron\\SentinelProbe\\": "src/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8"
    }
}
